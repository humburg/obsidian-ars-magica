filters:
  and:
    - file.inFolder("virtues")
properties:
  file.name:
    displayName: Virtue
  cost:
    displayName: Cost
  types:
    displayName: Type
  properties:
    displayName: Properties
views:
  - type: table
    name: "All Virtues"
    order:
      - file.name
      - cost
      - types
      - properties
    sort:
      - column: file.name
        direction: ASC
  - type: table
    name: "By Cost"
    groupBy:
      property: cost
      direction: ASC
    order:
      - file.name
      - types
      - properties
    sort:
      - column: file.name
        direction: ASC
